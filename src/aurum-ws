TEST_BUILD = (HERE / ".aurum-test-build").exists()         # never in a release tarball: test hooks are dead code there
ROOT = Path(os.environ.get("AURUM_ROOT", "/")) if TEST_BUILD else Path("/")
STATE = ROOT / "var/lib/aurum-ws"
STAGE = STATE / "stage"
MANIFEST = STATE / "manifest.json"
LOCK = STATE / "lock"
def cache_dir(m: dict) -> Path:
    """Per-install download folder; its name carries the record id, so everything in it is Aurum's by construction."""
    return STATE / f"cache-{m['id']}"
OLLAMA_DIR = ROOT / "usr/local/lib"
OLLAMA_LINK = ROOT / "usr/local/bin/ollama"
CLI_LINK = ROOT / "usr/local/sbin/aurum-ws"
UNIT = ROOT / "etc/systemd/system/ollama.service"
MODELS_DIR = ROOT / "var/lib/ollama"
APPORT = ROOT / "etc/default/apport"
POPCON = ROOT / "etc/popularity-contest.conf"
API = (os.environ.get("AURUM_OLLAMA_API") if TEST_BUILD else None) or "http://127.0.0.1:11434"
OWN_MARK = ".aurum-ws-owned"                                # written inside the Ollama dir BEFORE it is moved in place
ANSWER_S = 120


class Kept(str):
    """An undo result that KEEPS something on purpose: the step is re-checked on every later undo run (so a later
    'undo --purge-models' still removes a model an earlier plain undo kept)."""


class Stop(Exception):
    """A clear, user-facing reason to stop (nothing half-done is left unrecorded)."""


def say(msg: str) -> None:
    print(msg, flush=True)


def _die_with_parent():                                    # a killed installer never leaves curl/tar running
    try:
        ctypes.CDLL("libc.so.6").prctl(1, signal.SIGKILL)   # PR_SET_PDEATHSIG
    except OSError:
        pass


def run(cmd: list[str], check=True, timeout=None, **kw) -> subprocess.CompletedProcess:
    r = subprocess.run(cmd, capture_output=True, text=True, preexec_fn=_die_with_parent, timeout=timeout, **kw)
    if check and r.returncode != 0:
        raise Stop(f"command failed: {cmd[0]} {' '.join(cmd[1:3])} ... ({r.stderr.strip()[:200]})")
    return r


# ---------- release metadata (validated before any privileged work) ----------
def load_release() -> dict:
    r = json.loads((HERE / "release.json").read_text())
    hx = re.compile(r"^[0-9a-f]{64}$")
    o = r["ollama"]
    assert re.fullmatch(r"\d+\.\d+\.\d+", o["version"]) and hx.match(o["sha256"]) and isinstance(o["size"], int)
    assert o["url"] == f"https://github.com/ollama/ollama/releases/download/v{o['version']}/ollama-linux-amd64.tar.zst"
    mins = [m["min_ram_gb"] for m in r["models"]]
    assert mins == sorted(set(mins)) and mins[0] == 0
    for m in r["models"]:
        assert re.fullmatch(r"[a-z0-9.-]+:[a-z0-9.-]+", m["tag"]) and hx.match(m["digest"]) and isinstance(m["size"], int)
    assert set(r["ubuntu"]) <= {"24.04", "26.04"}
    return r


try:
    REL = load_release()
except (OSError, ValueError, KeyError, AssertionError, TypeError):
    if (str(HERE).startswith(str(STAGE) + "/") and HERE.is_dir() and set(os.listdir(HERE)) == {"aurum-ws"}
            and sys.argv[1:2] == ["undo"]):
        # a power cut hit between the last two steps of an undo: only this script is left - finish removing it
        if os.geteuid() != 0:
            print("STOPPED: run with sudo"); sys.exit(1)
        (HERE / "aurum-ws").unlink()
        HERE.rmdir()
        try:
            STAGE.rmdir()
        except OSError:
            pass
        print("Undo complete (removed the last staged file).")
        sys.exit(0)
    print("STOPPED: release.json is damaged - stage the release again (README step 3)")
    sys.exit(1)


# ---------- safe filesystem ----------
def root_dir(p: Path, mode: int) -> Path:
    """p must be a real directory owned by root and not writable by others (created if absent)."""
    try:
        st = p.lstat()
    except FileNotFoundError:
        p.parent.mkdir(parents=True, exist_ok=True)
        os.mkdir(p, mode)
        st = p.lstat()
    if not stat.S_ISDIR(st.st_mode) or (not TEST_BUILD and st.st_uid != 0) or st.st_mode & 0o022:
        raise Stop(f"{p} is not a root-owned real directory - refusing to use it")
    os.chmod(p, mode)
    return p


def atomic_write(path: Path, data: bytes, mode: int = 0o600, uid: int | None = None, gid: int | None = None) -> None:
    """Write via an exclusive no-follow temp file in a checked dir, fsync, rename, fsync the dir."""
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        if uid is not None:
            os.fchown(fd, uid, gid if gid is not None else -1)
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    dfd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def sha_nofollow(p: Path) -> str | None:
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        h = hashlib.sha256()
        while c := os.read(fd, 1 << 20):
            h.update(c)
        return h.hexdigest()
    finally:
        os.close(fd)


def file_state(p: Path) -> dict:
    """Everything undo needs to restore a system file exactly (type, owner, mode, content)."""
    try:
        st = p.lstat()
    except FileNotFoundError:
        return {"type": "absent"}
    if stat.S_ISLNK(st.st_mode):
        return {"type": "symlink", "target": os.readlink(p)}
    if not stat.S_ISREG(st.st_mode):
        return {"type": "other"}
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        data = b""
        while c := os.read(fd, 1 << 16):
            data += c
    finally:
        os.close(fd)
    return {"type": "file", "uid": st.st_uid, "gid": st.st_gid, "mode": stat.S_IMODE(st.st_mode),
            "content": data.decode("utf-8", "surrogateescape"), "sha": hashlib.sha256(data).hexdigest()}


# ---------- manifest ----------
def load_manifest() -> dict | None:
    try:
        st = MANIFEST.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(st.st_mode) or (not TEST_BUILD and (st.st_uid != 0 or st.st_mode & 0o077)):
        raise Stop(f"{MANIFEST} is not a root-only file - refusing to trust it (no guessing)")
    try:
        m = json.loads(MANIFEST.read_text())
        assert isinstance(m, dict) and isinstance(m.get("steps"), list)
        assert m.get("state") in ("INSTALLING", "INSTALLED", "INSTALLED_WITH_PROBLEM", "UNDOING")
        for s in m["steps"]:
            assert s["state"] in ("INTENT", "DONE", "UNDONE", "UNDO_FAILED", "SKIPPED", "KEPT") and isinstance(s["id"], str)
    except (ValueError, AssertionError, KeyError, TypeError):
        raise Stop(f"{MANIFEST} is damaged - Aurum refuses to guess; it contains: {MANIFEST.read_text()[:300]!r}")
    return m


def save_manifest(m: dict) -> None:
    atomic_write(MANIFEST, json.dumps(m, indent=1, sort_keys=True).encode())


def step(m: dict | None, sid: str) -> dict | None:
    return next((s for s in m["steps"] if s["id"] == sid), None) if m else None


def kill_point(sid: str, point: str) -> None:
    """Test builds only: die like a power cut at '<step>:intent' (recorded, nothing done) or '<step>:done' (done, not recorded)."""
    if TEST_BUILD and os.environ.get("AURUM_TEST_KILL_AT") == f"{sid}:{point}":
        os.kill(os.getpid(), signal.SIGKILL)


def begin(m: dict, sid: str, kind: str, resource: str, pre, post=None) -> dict:
    """Record INTENT (with the pre-state and the intended post-state) BEFORE the change."""
    s = step(m, sid)
    if s is None:
        s = {"id": sid, "kind": kind, "resource": resource, "pre": pre, "post": post, "state": "INTENT", "t": time.time()}
        m["steps"].append(s)
    else:
        s.update(state="INTENT")
        if post is not None:
            s["post"] = post
    save_manifest(m)
    kill_point(sid, "intent")
    return s


def done(m: dict, s: dict, **post) -> None:
    kill_point(s["id"], "done")
    s["state"] = "DONE"
    if post:
        s["post"] = {**(s.get("post") or {}), **post}
    save_manifest(m)


def skipped(m: dict, sid: str, kind: str, resource: str, pre, note: str) -> None:
    s = step(m, sid) or begin(m, sid, kind, resource, pre)
    s.update(state="SKIPPED", note=note)
    save_manifest(m)


def other_state(what: str) -> Stop:
    return Stop(f"{what} is in a state Aurum did not create (changed by someone else?) - stopping without touching it")


class Locked:
    def __enter__(self):
        root_dir(STATE, 0o755)
        fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        self.f = os.fdopen(fd, "r+")
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Stop("another aurum-ws run is active (lock held) - wait for it to finish")
        return self

    def __exit__(self, *a):
        self.f.close()


# ---------- host checks ----------
def os_release() -> dict:
    out = {}
    for line in (ROOT / "etc/os-release").read_text().splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            out[k] = v.strip().strip('"')
    return out


def check_stage() -> None:
    """The running code and every ancestor up to / must be root-owned and not writable by others."""
    if TEST_BUILD:
        return
    if not str(HERE).startswith(str(STAGE) + "/"):
        raise Stop(f"run the staged copy under {STAGE} (README step 3) - not {HERE}")
    p = HERE
    while True:
        st = p.lstat()
        if stat.S_ISLNK(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise Stop(f"{p} is not a root-owned, non-writable real directory - stage again (README step 3)")
        if p == p.parent:
            break
        p = p.parent
    for f in HERE.rglob("*"):
        st = f.lstat()
        if stat.S_ISLNK(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise Stop(f"staged file {f} is not root-owned or is writable by others - stage again (README step 3)")


def check_host(need_root=True) -> dict:
    if need_root and os.geteuid() != 0 and not TEST_BUILD:
        raise Stop("run with sudo (it changes system files); see the README")
    check_stage()
    osr = os_release()
    if osr.get("ID") != "ubuntu" or osr.get("VERSION_ID") not in REL["ubuntu"]:
        raise Stop(f"supported: Ubuntu {' / '.join(REL['ubuntu'])}; this is {osr.get('PRETTY_NAME', '?')}")
    if os.uname().machine != "x86_64":
        raise Stop("supported: x86_64 only in v1")
    if "microsoft" in Path("/proc/version").read_text().lower():
        raise Stop("WSL is not supported in v1")
    for tool in ("curl", "zstd", "tar", "minisign"):
        if not shutil.which(tool):
            raise Stop(f"missing tool '{tool}': run  sudo apt install curl zstd minisign  first (README step 1)")
    return osr


def ram_gb() -> int:
    kb = int(re.search(r"MemTotal:\s+(\d+)", Path("/proc/meminfo").read_text()).group(1))
    return int(round(kb * 1024 / 1e9))


def free_gb(path: Path) -> float:
    p = path
    while not p.exists():
        p = p.parent
    return shutil.disk_usage(p).free / 1e9


def gpus() -> list[str]:
    names = {"0x10de": "NVIDIA", "0x1002": "AMD", "0x8086": "Intel"}
    out = []
    for v in sorted(Path("/sys/class/drm").glob("card[0-9]*/device/vendor")):
        try:
            out.append(names.get(v.read_text().strip(), "other"))
        except OSError:
            pass
    return sorted(set(out))


def pick_model(ram: int, want: str | None) -> dict:
    ms = REL["models"]
    if want:
        m = next((x for x in ms if x["tag"] == want), None)
        if not m:
            raise Stop(f"--model must be one of: {', '.join(x['tag'] for x in ms)}")
        return m
    return [x for x in ms if ram >= x["min_ram_gb"]][-1]


def port_busy(port: int = 11434) -> bool:
    with socket.socket() as s:
        s.settimeout(0.5)
        return s.connect_ex(("127.0.0.1", port)) == 0


def existing_ollama() -> dict:
    binp = shutil.which("ollama")
    r = run(["systemctl", "list-unit-files", "--no-legend", "ollama.service"], check=False)
    unit = r.stdout.split()[0] if r.returncode == 0 and r.stdout.strip() else None
    try:
        user = pwd.getpwnam("ollama").pw_uid
    except KeyError:
        user = None
    return {"binary": binp, "unit": unit, "user": user, "port_busy": port_busy()}


def invoking_user():
    name = os.environ.get("SUDO_USER")
    if not name or name == "root":
        return None
    return pwd.getpwnam(name)


def as_user(pw, cmd: list[str], check=True, **kw):
    bus = f"unix:path=/run/user/{pw.pw_uid}/bus"
    return run(["runuser", "-u", pw.pw_name, "--", "env", f"DBUS_SESSION_BUS_ADDRESS={bus}", f"HOME={pw.pw_dir}", *cmd],
               check=check, **kw)


# ---------- Ollama API ----------
def api(path: str, body=None, timeout=30, method=None):
    req = urllib.request.Request(API + path, data=None if body is None else json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"},
                                 method=method or ("GET" if body is None else "POST"))
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read(1 << 22) or b"{}")


def tags() -> dict:
    return {m["name"]: m["digest"] for m in api("/api/tags").get("models", [])}


def api_delete(tag: str) -> None:
    """Raises if Ollama does not confirm the delete (never reported as removed when it is not)."""
    api("/api/delete", {"model": tag}, timeout=60, method="DELETE")
    if tag in tags():
        raise Stop(f"Ollama did not delete {tag}")


def wait_api(seconds=60, version: str | None = None) -> None:
    """Wait for Ollama; with version= it must be exactly that version (not something else on the port)."""
    end, seen = time.time() + seconds, None
    while time.time() < end:
        try:
            seen = api("/api/version", timeout=3).get("version")
            if version is None or seen == version:
                return
        except Exception:
            pass
        time.sleep(1)
    raise Stop("Ollama did not answer on 127.0.0.1:11434" + (f" (got version {seen}, expected {version})" if seen else ""))


